# Hardhat / Sepolia deployment
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
PRIVATE_KEY=your_deployer_wallet_private_key_without_0x_prefix

# Optional Etherscan verification
ETHERSCAN_API_KEY=

# Frontend (copy these into frontend/.env)
VITE_CONTRACT_ADDRESS=
VITE_CHAIN_ID=11155111
VITE_NETWORK_NAME=Sepolia
VITE_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
VITE_BLOCK_EXPLORER=https://sepolia.etherscan.io

# IPFS / Pinata
VITE_IPFS_API_KEY=your_pinata_api_key
VITE_IPFS_API_SECRET=your_pinata_api_secret
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_cloud_project_id
